# Plantilla para el backend en producción. Copiar a `.env`, completar los secretos y ejecutar
# `php artisan key:generate --force`. Nunca commitear el `.env` real.
APP_NAME=CarCheck
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.carcheck.digitalwebsolution.info
# La PWA vive en su propio subdominio: base de invitaciones y enlaces de avisos.
FRONTEND_URL=https://app.carcheck.digitalwebsolution.info

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE
# Los recordatorios de las 08:00 y los vencimientos usan la fecha local.
APP_TIMEZONE=America/Caracas

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# PostgreSQL del hosting compartido. En cPanel el nombre de la base y del
# usuario llevan el prefijo de la cuenta.
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=usuario_carcheck
DB_USERNAME=usuario_carcheck
DB_PASSWORD=CAMBIA_ESTA_CLAVE

# Instalación sin Terminal (cPanel + cron): define el primer super_admin aquí,
# ejecuta `php artisan migrate --seed --force` y BORRA estas tres líneas después.
# ADMIN_EMAIL=admin@tudominio.com
# ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE
# ADMIN_NAME=Administrador

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Obligatorio con HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Email y push se procesan en segundo plano: requiere un worker (ver DEPLOY.md).
QUEUE_CONNECTION=database
CACHE_STORE=database

# Origen de la PWA, sin barra final. Varios orígenes separados por coma.
CORS_ALLOWED_ORIGINS=https://app.carcheck.digitalwebsolution.info

MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=smtp.carcheck.example
MAIL_PORT=465
MAIL_USERNAME=no-reply@carcheck.example
MAIL_PASSWORD=CAMBIA_ESTA_CLAVE
MAIL_FROM_ADDRESS="no-reply@carcheck.example"
MAIL_FROM_NAME="${APP_NAME}"

# Push PWA. Generar el par con `php artisan webpush:vapid`.
VAPID_SUBJECT=https://carcheck.digitalwebsolution.info
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Los documentos se guardan en el disco `public`: ejecutar `php artisan storage:link`.
MEDIA_DISK=public
